# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Discord Bot Integration (Server-side)
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=""

# Telegram OpenID Connect (OIDC) & Bot Integration (Server-side)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_NAME="CommunityOutcomeBot"
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""
TELEGRAM_REDIRECT_URI=""

# Supabase PostgreSQL Integration (Server-side)
# Configure these secrets in your deployment environment or project settings
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Community OS Pro Monetization & Payment Providers (Server-side & Modular)
# Whop is preferred; Gumroad supported as modular alternative
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_PRO_PRODUCT_ID="community-os-pro"
NEXT_PUBLIC_WHOP_CHECKOUT_URL="https://whop.com/baha-1a44/community-os-pro"
GUMROAD_ACCESS_TOKEN=""
GUMROAD_PRODUCT_ID=""

# Session Security (Server-side HttpOnly SameSite=Lax cookie encryption)
SESSION_SECRET="your-32-character-random-session-secret"

# Cloudflare Workers Free Deployment Secrets:
# Configure via Wrangler:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_WEBHOOK_SECRET
#   npx wrangler secret put DISCORD_BOT_TOKEN
#   npx wrangler secret put DISCORD_PUBLIC_KEY
#   npx wrangler secret put WHOP_WEBHOOK_SECRET
#   npx wrangler secret put SESSION_SECRET


