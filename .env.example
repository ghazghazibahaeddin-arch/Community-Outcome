# Community OS — Environment Configuration (.env.example)

# APP
APP_URL="https://community-os.workers.dev"

# DISCORD
DISCORD_APPLICATION_ID="1347000000000000000"
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_SECRET=""
DISCORD_PUBLIC_KEY=""
DISCORD_REDIRECT_URI=""

# TELEGRAM
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="CommunityOutcomeBot"
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""
TELEGRAM_REDIRECT_URI=""

# SUPABASE
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# WHOP
WHOP_COMPANY_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_PRO_PLAN_ID="prod_community_pro_15"
WHOP_PURCHASE_URL="https://whop.com/baha-1a44/community-os-pro"
WHOP_PRODUCT_URL="https://whop.com/baha-1a44"

# Cloudflare Workers Secrets Configuration:
# To set encrypted production secrets in Cloudflare Workers:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_SECRET_KEY
#   npx wrangler secret put SUPABASE_PUBLISHABLE_KEY
#   npx wrangler secret put DISCORD_BOT_TOKEN
#   npx wrangler secret put DISCORD_CLIENT_SECRET
#   npx wrangler secret put DISCORD_PUBLIC_KEY
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_WEBHOOK_SECRET
#   npx wrangler secret put TELEGRAM_OIDC_CLIENT_SECRET
#   npx wrangler secret put WHOP_WEBHOOK_SECRET
#   npx wrangler secret put WHOP_COMPANY_API_KEY
